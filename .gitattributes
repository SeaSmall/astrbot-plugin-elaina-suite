# 统一换行符：文本文件入库用 LF，避免 Windows CRLF 转换
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
LICENSE text eol=lf

# 表情包素材是二进制，禁止任何换行符/编码转换
meme/*.gif binary
meme/*.jpg binary
meme/*.jpeg binary
meme/*.png binary
meme/*.webp binary